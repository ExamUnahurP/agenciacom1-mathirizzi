import agenciaDeViajes.*

describe "Tests agenciacom1"{

    const trasladoHotel = new BeneficioEspecial(tipo = "Traslados privados", costo = 100, estaVigente = true)

    const accesoZoom = new BeneficioEspecial(tipo = "Acceso a salas VIP", costo = 200, estaVigente = true)

    const roberto 

    const packNacionalSinBeneficios = new PackNacional(duracion = 7, precioBase = 500, provinciaDestino = "Mendoza")

    const packNacionalConBeneficios = new PackNacional(duracion = 7, precioBase = 500, provinciaDestino = "Mendoza")

    const packInternacionalSinBeneficios = new PackInternacional(duracion = 7, precioBase = 500, paisDestino = "Brasil", cantidadEscalas = 0, esLugarDeInteres = true)

    test "pack nacional sin beneficios"{
    assert.equals(500, packNacionalSinBeneficios.valorFinal())
    }

    test "pack nacional con beneficios"{
    assert.equals(800, packNacionalConBeneficios.valorFinal())
    }

    test "pack internacional sin beneficios"{
    assert.equals(600, packInternacionalSinBeneficios.valorFinal())
    }


}